<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="central_goods_monitoring_view_tree" model="ir.ui.view">
        <field name="name">central.goods.monitoring.tree</field>
        <field name="model">central.goods.monitoring</field>
        <field name="arch" type="xml">
            <tree create="false" sample="1">
                <header>
                    <button name="action_fetch_data" string="Fetch Data" type="object" class="oe_highlight"/>
                </header>
                <field name="name"/>
                <field name="responsible_name"/>
                <field name="source_location_name"/>
                <field name="request_date"/>
                <field name="destination_location_name"/>
                <field name="state"/>
                <field name="local_state" decoration-success="local_state == 'validated'" decoration-info="local_state == 'draft'" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="central_goods_monitoring_view_form" model="ir.ui.view">
        <field name="name">central.goods.monitoring.form</field>
        <field name="model">central.goods.monitoring</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" attrs="{'invisible': [('local_state', '=', 'validated')]}"/>
                    <field name="local_state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="responsible_name" readonly="1"/>
                            <field name="source_location_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_date" readonly="1"/>
                            <field name="destination_location_name" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="allowed_branch_stock_source_ids" invisible="1"/>
                            <field name="branch_stock_source_id" attrs="{'readonly': [('local_state', '=', 'validated')]}" domain="[('id', 'in', allowed_branch_stock_source_ids)]" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Lines">
                            <field name="line_ids" attrs="{'readonly': [('local_state', '=', 'validated')]}">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="product_name" readonly="1"/>
                                    <field name="barcode" readonly="1"/>
                                    <field name="category_name" readonly="1"/>
                                    <field name="uom_name" readonly="1"/>
                                    <field name="quantity_out" readonly="1"/>
                                    <field name="quantity_in"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_central_goods_monitoring" model="ir.actions.act_window">
        <field name="name">Central Goods Monitoring</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">central.goods.monitoring</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_server_fetch_data" model="ir.actions.server">
        <field name="name">Fetch Data from Remote</field>
        <field name="model_id" ref="model_central_goods_monitoring"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_fetch_data()
        </field>
    </record>

    <record id="central_goods_monitoring_line_view_tree" model="ir.ui.view">
        <field name="name">central.goods.monitoring.line.tree</field>
        <field name="model">central.goods.monitoring.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="monitoring_id"/>
                <field name="product_name"/>
                <field name="barcode"/>
                <field name="category_name"/>
                <field name="uom_name"/>
                <field name="quantity_out"/>
                <field name="quantity_in"/>
            </tree>
        </field>
    </record>

    <record id="central_goods_monitoring_line_view_search" model="ir.ui.view">
        <field name="name">central.goods.monitoring.line.search</field>
        <field name="model">central.goods.monitoring.line</field>
        <field name="arch" type="xml">
            <search string="Check Out New Products">
                <field name="product_name"/>
                <field name="barcode"/>
                <field name="category_name"/>
                <field name="monitoring_id"/>
                <filter string="New Products" name="new_products" domain="[('is_new_product', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_central_goods_monitoring_new_products" model="ir.actions.act_window">
        <field name="name">Check Out New Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">central.goods.monitoring.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('is_new_product', '=', True)]</field>
        <field name="context">{'search_default_new_products': 1}</field>
    </record>
</odoo>
