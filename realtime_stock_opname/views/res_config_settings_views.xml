<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_realtime_stock_opname" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.realtime_stock_opname</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Realtime Stock Opname" string="Realtime Stock Opname" data-key="realtime_stock_opname">
                    <h2>Realtime Stock Opname</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Allowed Users</span>
                                <div class="text-muted">
                                    Specific users who are allowed to access the Realtime Stock Opname menu in the backend.
                                </div>
                                <div class="content-group mt16">
                                    <field name="stock_opname_user_ids" widget="many2many_tags" placeholder="Select allowed users..."/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Allowed Apply Adjustment Users</span>
                                <div class="text-muted">
                                    Specific users who are allowed to use the Apply Adjustment button on stock opname sessions.
                                </div>
                                <div class="content-group mt16">
                                    <field name="stock_opname_apply_user_ids" widget="many2many_tags" placeholder="Select allowed apply adjustment users..."/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Allowed Document Lock Users</span>
                                <div class="text-muted">
                                    Specific users who are allowed to use the Document Lock button on stock opname sessions.
                                </div>
                                <div class="content-group mt16">
                                    <field name="stock_opname_lock_user_ids" widget="many2many_tags" placeholder="Select allowed document lock users..."/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Allowed Unlock Users</span>
                                <div class="text-muted">
                                    Specific users who are allowed to use the Unlock button on completed stock opname sessions.
                                </div>
                                <div class="content-group mt16">
                                    <field name="stock_opname_unlock_user_ids" widget="many2many_tags" placeholder="Select allowed unlock users..."/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Allowed Delete Line Users</span>
                                <div class="text-muted">
                                    Specific users who are allowed to delete lines in Realtime Stock Opname.
                                </div>
                                <div class="content-group mt16">
                                    <field name="stock_opname_delete_user_ids" widget="many2many_tags" placeholder="Select allowed delete line users..."/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Filter By Locations</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Filter By Locations</span>
                                <div class="content-group mt16">
                                    <field name="stock_opname_location_ids" widget="many2many_tags" placeholder="Select locations..."/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_realtime_stock_opname_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'realtime_stock_opname', 'bin_size': False}</field>
    </record>
</odoo>
