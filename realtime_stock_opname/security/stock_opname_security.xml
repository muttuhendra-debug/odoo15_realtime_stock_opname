<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_realtime_stock_opname" model="ir.module.category">
        <field name="name">Realtime Stock Opname</field>
        <field name="description">Security category for Realtime Stock Opname access</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_realtime_stock_opname_user" model="res.groups">
        <field name="name">User Access</field>
        <field name="category_id" ref="module_category_realtime_stock_opname"/>
        <field name="comment">Users allowed to access Realtime Stock Opname menu and operations</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_realtime_stock_opname_apply" model="res.groups">
        <field name="name">Apply Adjustment Access</field>
        <field name="category_id" ref="module_category_realtime_stock_opname"/>
        <field name="comment">Users allowed to apply stock adjustments in Realtime Stock Opname</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_realtime_stock_opname_lock" model="res.groups">
        <field name="name">Document Lock Access</field>
        <field name="category_id" ref="module_category_realtime_stock_opname"/>
        <field name="comment">Users allowed to use the Document Lock button on stock opname sessions</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_realtime_stock_opname_unlock" model="res.groups">
        <field name="name">Unlock Access</field>
        <field name="category_id" ref="module_category_realtime_stock_opname"/>
        <field name="comment">Users allowed to unlock completed Realtime Stock Opname sessions</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_realtime_stock_opname_delete" model="res.groups">
        <field name="name">Delete Line Access</field>
        <field name="category_id" ref="module_category_realtime_stock_opname"/>
        <field name="comment">Users allowed to delete lines in Realtime Stock Opname</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
